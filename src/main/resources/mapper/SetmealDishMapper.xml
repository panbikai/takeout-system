<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nnu.takeout.mapper.SetmealDishMapper">

    <resultMap id="setmealDishMap" type="com.nnu.takeout.entity.SetmealDish">
        <id column="id" property="id"/>
        <result column="setmeal_id" property="setmealId"/>
        <result column="dish_id" property="dishId"/>
        <result column="name" property="name"/>
        <result column="price" property="price"/>
        <result column="copies" property="copies"/>
    </resultMap>

    <insert id="batchInsert">
        INSERT INTO setmeal_dish (setmeal_id, dish_id, name, price, copies)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.setmealId}, #{item.dishId}, #{item.name}, #{item.price}, #{item.copies})
        </foreach>
    </insert>

    <select id="listBySetmealId" resultMap="setmealDishMap">
        SELECT * FROM setmeal_dish WHERE setmeal_id = #{setmealId}
    </select>

    <delete id="deleteBySetmealId">
        DELETE FROM setmeal_dish WHERE setmeal_id = #{setmealId}
    </delete>

    <select id="countByDishId" resultType="java.lang.Long">
        SELECT COUNT(*) FROM setmeal_dish WHERE dish_id = #{dishId}
    </select>

</mapper>
