<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.nnu.takeout.mapper.AddressBookMapper">

    <resultMap id="addressMap" type="com.nnu.takeout.entity.AddressBook">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="consignee" property="consignee"/>
        <result column="phone" property="phone"/>
        <result column="sex" property="sex"/>
        <result column="province" property="province"/>
        <result column="city" property="city"/>
        <result column="district" property="district"/>
        <result column="detail" property="detail"/>
        <result column="label" property="label"/>
        <result column="is_default" property="isDefault"/>
    </resultMap>

    <select id="listByUserId" resultMap="addressMap">
        SELECT * FROM address_book
        WHERE user_id = #{userId}
        ORDER BY is_default DESC, id DESC
    </select>

    <insert id="insert" parameterType="com.nnu.takeout.entity.AddressBook" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO address_book (user_id, consignee, phone, sex, province, city, district, detail, label, is_default)
        VALUES (#{userId}, #{consignee}, #{phone}, #{sex}, #{province}, #{city}, #{district}, #{detail}, #{label}, #{isDefault})
    </insert>

    <select id="getById" resultMap="addressMap">
        SELECT * FROM address_book WHERE id = #{id}
    </select>

    <update id="update" parameterType="com.nnu.takeout.entity.AddressBook">
        UPDATE address_book
        <set>
            <if test="consignee != null">consignee = #{consignee},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="sex != null">sex = #{sex},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="district != null">district = #{district},</if>
            <if test="detail != null">detail = #{detail},</if>
            <if test="label != null">label = #{label},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM address_book WHERE id = #{id}
    </delete>

    <update id="clearDefault">
        UPDATE address_book SET is_default = 0 WHERE user_id = #{userId}
    </update>

    <select id="getDefault" resultMap="addressMap">
        SELECT * FROM address_book WHERE user_id = #{userId} AND is_default = 1 LIMIT 1
    </select>

</mapper>
