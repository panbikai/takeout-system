# =====================================================================
# 本地配置模板
# 使用方法：把本文件复制为同目录下的 application.yml，再按本机环境修改。
#   Windows: copy application.yml.example application.yml
#   macOS/Linux: cp application.yml.example application.yml
# 注意：application.yml 已被 .gitignore 排除，不会提交到仓库。
# =====================================================================

server:
  port: 8080

spring:
  application:
    name: takeout-system
  # 数据源配置：请按本机 MySQL 实际端口、账号、密码修改
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/takeout_db?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: "your_password"
  # 文件上传大小限制（菜品/套餐图片）
  servlet:
    multipart:
      max-file-size: 10MB
      max-request-size: 10MB

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.nnu.takeout.entity
  configuration:
    map-underscore-to-camel-case: true
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

logging:
  level:
    com.nnu.takeout: debug
